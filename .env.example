PORT=8787
BOT_TOKEN=
BOT_USERNAME=
MINIAPP_URL=https://alamat-miniapp-lo
ALLOW_DEMO=false
# Aktifkan hanya setelah Pakasir production siap. Default false: akses diatur admin.
SELF_SERVICE_SUBSCRIPTIONS=false
# Jangan gunakan DEV_BYPASS_AUTH di production.
ADMIN_TELEGRAM_IDS=123456789
# Isi dengan ID Telegram admin, pisahkan koma bila lebih dari satu.
# Opsional, namun direkomendasikan agar buyer kembali ke Main Mini App setelah pembayaran.
# Isi tanpa @, contoh: KertaajiBot
PAKASIR_PROJECT=
PAKASIR_API_KEY=
# Di dashboard Pakasir, isi Webhook URL proyek ke:
# https://domain-miniapp-lo/api/payments/pakasir/webhook
WITHDRAW_NOTIFY_TELEGRAM_ID=
# ID Telegram @notjrnss. Akun ini harus sudah menekan /start ke bot client terlebih dahulu.

# Koneksi akun Telegram untuk worker Auto Sebar dan akun buyer Auto Komen MF.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Buat dua rahasia berbeda, masing-masing minimal 24 karakter.
WORKER_SESSION_KEY=
LPM_ADAPTER_TOKEN=
# Opsional. Default 8000 ms untuk mencegah request database menggantung.
SUPABASE_TIMEOUT_MS=8000

# Supabase / PostgreSQL. Isi ketiganya saat mau pindah ke production.
# Secret key hanya dipasang di Railway/server, jangan pernah di Vite atau browser.
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_SECRET_KEY=
# Connection string Postgres dari Supabase Dashboard > Connect.
# Hanya dibutuhkan untuk menjalankan: npm run db:migrate
SUPABASE_DB_URL=
